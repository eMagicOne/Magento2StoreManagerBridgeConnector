{
    "name": "emagicone/module-connector",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "description": "Install Magento Store Manager Connector module to fluently connect Store Manager desktop application to Magento database. Increase speed of data management, take advantage of simplicity and reliability with all-in-one Store Manager via Magento Store Manager Bridge Connector.",
    "type": "magento2-module",
    "version": "26.6.0",
    "require": {
      "emagicone/module-core": ">=1.0.3"
    },
    "authors": [
      {
        "name": "Emagicone",
        "email": "support@emagicone.com",
        "homepage": "https://emagicone.com",
        "role": "Technical Support"
      }
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Emagicone\\Connector\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
